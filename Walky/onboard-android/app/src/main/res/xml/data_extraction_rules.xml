<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The Pico pairing is a Wi-Fi password for one robot; it stays on this phone. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="pico_link.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pico_link.xml" />
    </device-transfer>
</data-extraction-rules>
